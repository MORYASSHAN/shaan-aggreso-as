NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/modwb?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
AI_PROVIDER=mock            # mock | gemini
GEMINI_API_KEY=             # free key from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite # any Gemini model with function calling; quotas are per model
AI_TIMEOUT_MS=60000
AI_CONCURRENCY=1            # keep at 1 on the Gemini free tier (small per-minute quotas)
APPEAL_WINDOW_DAYS=14
LOG_LEVEL=info
DNS_FALLBACK=               # optional; DNS servers for mongodb+srv lookups if the local resolver fails ("none" disables)

# Seed script (npm run seed)
DEMO_PASSWORD=              # password for the 5 demo accounts; defaults to 1234
SEED_AI_PROVIDER=           # AI used while seeding; defaults to mock so seeding never hits Gemini limits

# Client build (optional): one-click demo logins on the sign-in page. Demo environments only.
VITE_DEMO_PASSWORD=
