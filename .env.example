NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/modwb
JWT_SECRET=change-me-to-a-long-random-string
AI_PROVIDER=mock            # mock | claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # a current Claude model ID that accepts a forced tool call, e.g. claude-opus-5
AI_TIMEOUT_MS=30000
AI_CONCURRENCY=2
APPEAL_WINDOW_DAYS=14
LOG_LEVEL=info
DEMO_PASSWORD=              # password given to the 5 seeded demo accounts (npm run seed)
