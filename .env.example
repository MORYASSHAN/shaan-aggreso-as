NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/modwb?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
AI_PROVIDER=mock            # mock | gemini
GEMINI_API_KEY=             # free key from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash # any Gemini model with function calling on the free tier
AI_TIMEOUT_MS=60000
AI_CONCURRENCY=1            # keep at 1 on the Gemini free tier (low requests-per-minute limit)
APPEAL_WINDOW_DAYS=14
LOG_LEVEL=info
DEMO_PASSWORD=              # password given to the 5 seeded demo accounts (npm run seed)
